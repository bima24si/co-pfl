{
  "name": "co-pfl-root",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "./co-pfl"
  ],
  "scripts": {
    "install-inner": "npm --prefix ./co-pfl install --include=dev",
    "dev": "npm --prefix ./co-pfl run dev",
    "build": "npm --prefix ./co-pfl install --include=dev && npm --prefix ./co-pfl run build && node copy-dist.js",
    "preview": "npm --prefix ./co-pfl run preview"
  }
}
